# Docker local demonstration defaults to development because it uses HTTP.
# Use production only behind HTTPS. Never commit an actual .env file.
APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:8080
# Optional: point at an authenticated MLflow service reachable by API/worker.
MLFLOW_TRACKING_URI=
